#!/usr/bin/env bash
# A pull request's test stack: a Sandbox stack that follows the PR's branch.
#
# Installed as /usr/local/lib/miu/pr-stack. It runs as the account that owns
# Sandbox, through one sudo rule install.sh adds, because Miu's own account
# cannot reach Sandbox. Miu decides (lib/prstacks.mjs); this only carries out,
# and builds every Sandbox argument itself, so Miu can name nothing but a
# stack, a kind and branches:
#
#   pr-stack mem                                   MB of memory available
#   pr-stack add <stack> <wp|full> free=<branch> pro=<branch> [hub=<branch>]
#   pr-stack status <stack>                        the follow's status, JSON
#   pr-stack ports <stack>                         the stack's ports and incarnation, JSON
#   pr-stack remove <stack>                        follow and stack, gone
#   pr-stack wp-session <stack> <run>              a session for miu-qa on the stack's WordPress, JSON
#   pr-stack wp-session-end <stack> <run>          that run's session, ended
#
# wp-session reads the session token Miu made on stdin (43 letters and
# digits). WordPress stores only its hash and prints only the cookies'
# signatures, so no output, argv or log of this or Sandbox holds a working
# cookie: Miu puts the token and the signatures together itself.
#
# Fixed here, not by the caller: the org (WPDevelopers), the setup repo and
# its branch (xspeed-dev-setup@main, whose stacks/follow-prepare.sh is the
# prepare step), the template, the ref and the owner. Nothing from a PR
# branch runs on this host: follow-prepare.sh builds PR code in a container.
set -euo pipefail

die() { echo "pr-stack: $*" >&2; exit 2; }
ORG=WPDevelopers
SETUP_BRANCH=main
# The licensing SDK Pro's composer needs; its default branch.
LICENSING_BRANCH=main
OWNER=miu
PREPARE_TIMEOUT=3600
# Only a test can point these elsewhere: under sudo they are dropped, whatever
# this server's sudoers keeps.
[ -z "${SUDO_USER:-}" ] || unset MIU_PR_STACK_SB MIU_PR_STACK_FOLLOW_ROOT MIU_PR_STACK_MEMINFO MIU_PR_STACK_DOCKER MIU_PR_STACK_LOCKS
sb=${MIU_PR_STACK_SB:-$HOME/sandbox/sb-src/sb}
docker=${MIU_PR_STACK_DOCKER:-docker}
locks=${MIU_PR_STACK_LOCKS:-$HOME/sandbox/runtime/miu-pr-stack}
follow_root=${MIU_PR_STACK_FOLLOW_ROOT:-$HOME/sandbox/runtime/hosting/follow}
meminfo=${MIU_PR_STACK_MEMINFO:-/proc/meminfo}
export SANDBOX_AUTO_UPDATE=0

name_ok() { [[ $1 =~ ^(wp-)?pr-(free|pro|hub)-[0-9]{1,6}$ || $1 == pr-hub-base ]]; }
# The same rule as lib/prstacks.mjs BRANCH and Sandbox's follow spec.
branch_ok() {
  [[ $1 =~ ^[A-Za-z0-9._/-]{1,200}$ ]] && [[ $1 != -* && $1 != /* && $1 != */ && $1 != *. && $1 != *.lock ]] \
    && [[ $1 != *..* && $1 != *//* && $1 != */.* && $1 != HEAD ]]
}

# Sandbox's host-local owner path for `host follow` and `host stack down`
# (Sandbox Fix 5). Every Sandbox call goes through here.
here() { "$sb" host "$@" --here --json; }

# The run a WordPress session belongs to: a Miu run folder's name.
run_ok() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$ ]]; }

# The stack's wp-setup container: WP-CLI, the site's docroot and database, and
# one per stack (it is not blue-green). `sb host exec` needs --remote, which
# this server has none of for itself, so this goes to Docker directly, by the
# labels Sandbox's compose project gives it.
wp_container() {
  local ids
  ids=$("$docker" ps -q --filter "label=com.docker.compose.project=sandbox-host-xspeed-hub-$1-sandbox" --filter label=com.docker.compose.service=wp-setup)
  [ -n "$ids" ] || { echo '{"ok":false,"code":"wp_container_not_found"}'; exit 1; }
  [ "$(printf '%s\n' "$ids" | wc -l)" -eq 1 ] || { echo '{"ok":false,"code":"wp_container_ambiguous"}'; exit 1; }
  printf '%s\n' "$ids"
}

# PHP run by `wp eval` in that container. MIU_RUN names the run; the token is
# read from stdin. Sessions are WordPress's own (user meta session_tokens,
# keyed by the token's sha256, as WP_User_Meta_Session_Tokens keeps them),
# each tagged with its run, so ending one run's never ends another's.
read -r -d '' WP_COMMON <<'PHP' || true
error_reporting(0);
$say = function ($o, $code = 0) { echo json_encode($o), "\n"; exit($code); };
$run = (string) getenv('MIU_RUN');
if (!preg_match('/^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$/', $run)) $say(['ok' => false, 'code' => 'bad_run'], 1);
$u = get_user_by('login', 'miu-qa');
if (!$u || !in_array('administrator', (array) $u->roles, true)) $say(['ok' => false, 'code' => 'wp_qa_user_missing'], 1);
$all = get_user_meta($u->ID, 'session_tokens', true);
if (!is_array($all)) $all = [];
$now = time();
foreach ($all as $k => $s) {
  if (!is_array($s) || ($s['expiration'] ?? 0) < $now || (($s['miu_run'] ?? null) === $run)) unset($all[$k]);
}
PHP
read -r -d '' WP_START <<'PHP' || true
$t = trim((string) fgets(STDIN));
if (!preg_match('/^[A-Za-z0-9]{43}$/', $t)) $say(['ok' => false, 'code' => 'bad_token'], 1);
$exp = $now + 4 * 3600;
$all[hash('sha256', $t)] = ['expiration' => $exp, 'login' => $now, 'ip' => '', 'ua' => 'miu', 'miu_run' => $run];
update_user_meta($u->ID, 'session_tokens', $all);
// Only the signature leaves: login|expiration|token|signature, token dropped.
$sig = function ($scheme) use ($u, $exp, $t) { $p = explode('|', wp_generate_auth_cookie($u->ID, $exp, $scheme, $t)); return $p[3]; };
$host = parse_url(get_option('siteurl'), PHP_URL_HOST);
$say(['ok' => true, 'host' => $host, 'login' => $u->user_login, 'expires' => $exp, 'cookies' => [
  ['name' => SECURE_AUTH_COOKIE, 'path' => ADMIN_COOKIE_PATH, 'sig' => $sig('secure_auth')],
  ['name' => SECURE_AUTH_COOKIE, 'path' => PLUGINS_COOKIE_PATH, 'sig' => $sig('secure_auth')],
  ['name' => AUTH_COOKIE, 'path' => ADMIN_COOKIE_PATH, 'sig' => $sig('auth')],
  ['name' => LOGGED_IN_COOKIE, 'path' => COOKIEPATH, 'sig' => $sig('logged_in')],
]]);
PHP
read -r -d '' WP_END <<'PHP' || true
$before = get_user_meta($u->ID, 'session_tokens', true);
$ended = is_array($before) ? count($before) - count($all) : 0;
if ($all) update_user_meta($u->ID, 'session_tokens', $all); else delete_user_meta($u->ID, 'session_tokens');
$say(['ok' => true, 'ended' => $ended]);
PHP
wp_eval() { # wp_eval <container> <run> <php>; stdin goes through
  "$docker" exec -i -u 33:33 -w /var/www/html -e HOME=/tmp -e "MIU_RUN=$2" "$1" wp eval --skip-plugins --skip-themes "$3"
}

[ $# -ge 1 ] || die "usage: pr-stack mem | add <stack> <wp|full> free=<b> pro=<b> [hub=<b>] | status <stack> | ports <stack> | remove <stack> | wp-session <stack> <run> | wp-session-end <stack> <run>"
verb=$1; shift
case $verb in
  mem)
    [ $# -eq 0 ] || die "mem takes nothing"
    kb=$(awk '$1 == "MemAvailable:" { print $2; exit }' "$meminfo")
    [[ $kb =~ ^[0-9]+$ ]] || die "no MemAvailable in $meminfo"
    echo $((kb / 1024))
    ;;
  add)
    [ $# -ge 4 ] || die "usage: pr-stack add <stack> <wp|full> free=<branch> pro=<branch> [hub=<branch>]"
    stack=$1 kind=$2; shift 2
    name_ok "$stack" || die "not a PR stack name: $stack"
    case $kind in
      wp) [[ $stack == wp-* ]] || die "a WordPress-only stack is wp-pr-...: $stack" ;;
      full) [[ $stack != wp-* ]] || die "a full stack is pr-...: $stack" ;;
      *) die "kind is wp or full: $kind" ;;
    esac
    declare -A br=()
    for pair in "$@"; do
      role=${pair%%=*} b=${pair#*=}
      [[ $role =~ ^(free|pro|hub)$ ]] && [[ $pair == *=* ]] || die "not role=branch: $pair"
      [ -z "${br[$role]:-}" ] || die "$role given twice"
      branch_ok "$b" || die "not a branch name Sandbox accepts: $b"
      br[$role]=$b
    done
    [ -n "${br[free]:-}" ] && [ -n "${br[pro]:-}" ] || die "free and pro are both needed"
    if [ "$kind" = full ]; then [ -n "${br[hub]:-}" ] || die "a full stack needs hub"; else [ -z "${br[hub]:-}" ] || die "a WordPress-only stack has no hub"; fi
    args=(follow add --name "$stack"
      --repo "setup=$ORG/xspeed-dev-setup@$SETUP_BRANCH"
      --repo "free=$ORG/xspeed@${br[free]}"
      --repo "pro=$ORG/xspeed-pro@${br[pro]}"
      --repo "licensing=$ORG/licensing@$LICENSING_BRANCH")
    if [ "$kind" = full ]; then
      args+=(--repo "hub=$ORG/xspeed-hub@${br[hub]}" --stack-template "{dir}/hub-$stack/sandbox.full.hosting.yml" --ref "sandbox-env/$stack")
    else
      args+=(--stack-template "{dir}/stage/sandbox.hosting.yml" --ref "stack/$stack")
    fi
    args+=(--prepare "{repo:setup}/stacks/follow-prepare.sh $kind {name}" --prepare-timeout "$PREPARE_TIMEOUT" --owner "$OWNER" --generate)
    here "${args[@]}"
    ;;
  status)
    [ $# -eq 1 ] && name_ok "$1" || die "usage: pr-stack status <stack>"
    here follow status --name "$1"
    ;;
  ports)
    # One line: {"ok":true,"slug":..,"created_at":..,"copy_id":..,"ports":{..}}. The incarnation
    # (created_at, copy_id) tells a stack from an earlier one of the same name.
    [ $# -eq 1 ] && name_ok "$1" || die "usage: pr-stack ports <stack>"
    here stack list | tail -n 1 | python3 -c '
import json, sys
name = sys.argv[1]
try:
    d = json.loads(sys.stdin.read())
except ValueError:
    print(json.dumps({"ok": False, "code": "stack_list_unreadable"})); sys.exit(1)
hit = [s for s in d.get("stacks") or [] if s.get("slug") == name]
if not hit:
    print(json.dumps({"ok": False, "code": d.get("code") or "stack_not_found"})); sys.exit(1)
s = hit[0]
print(json.dumps({"ok": True, "slug": name, "created_at": s.get("created_at"), "copy_id": s.get("copy_id"), "ports": s.get("ports") or {}}))
' "$1"
    ;;
  remove)
    [ $# -eq 1 ] && name_ok "$1" || die "usage: pr-stack remove <stack>"
    stack=$1
    # A pause first, so no new attempt starts; remove is refused while one runs
    # (follow_attempt_running), and Miu asks again on its next scan.
    here follow pause --name "$stack" >/dev/null 2>&1 || true
    out=$(here follow remove --name "$stack" 2>&1) || {
      [[ $out == *follow_not_found* ]] || { printf '%s\n' "$out"; exit 1; }
    }
    # A stack already gone (reaped, taken down, never built) is done, not an error.
    out=$(here stack down --name "$stack" --owner "$OWNER" --confirm 2>&1) || {
      [[ $out == *stack_not_found* ]] || { printf '%s\n' "$out"; exit 1; }
    }
    printf '%s\n' "$out"
    # Sandbox keeps the follow's clones; with the stack down nothing uses them.
    work=$follow_root/work/$stack
    if [ -e "$work" ]; then
      [ ! -L "$work" ] && [ -d "$work" ] || die "$work is not a plain folder; left as it is"
      rm -rf -- "$work"
    fi
    ;;
  wp-session|wp-session-end)
    [ $# -eq 2 ] && name_ok "$1" && [[ $1 != wp-* ]] && run_ok "$2" || die "usage: pr-stack $verb <full stack> <run>"
    # One session change at a time per stack: each reads and writes miu-qa's
    # whole session list, so two at once could bring back one just ended.
    install -d -m 0700 "$locks"
    exec 9>"$locks/wp-session-$1.lock"
    flock -w 120 9 || { echo '{"ok":false,"code":"wp_session_busy"}'; exit 1; }
    c=$(wp_container "$1") || { printf '%s\n' "$c"; exit 1; }
    if [ "$verb" = wp-session ]; then
      # One line, checked here too, and handed on without a copy in argv or a file.
      IFS= read -r token || true
      [[ $token =~ ^[A-Za-z0-9]{43}$ ]] || die "wp-session reads a 43-character token on stdin"
      printf '%s\n' "$token" | wp_eval "$c" "$2" "$WP_COMMON"$'\n'"$WP_START"
    else
      wp_eval "$c" "$2" "$WP_COMMON"$'\n'"$WP_END" < /dev/null
    fi
    ;;
  *) die "unknown verb: $verb" ;;
esac
