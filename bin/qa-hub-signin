#!/usr/bin/env node
// qa-hub-signin --stack pr-hub-88 --incarnation <created_at/copy_id> --mailpit-port 18123
//               --admin-out <admin-state.json> --app-out <app-state.json> [--runs-dir DIR]
//
// Signs Miu's QA address into the stack's Hub admin console, and the seeded
// QA account into its account app (lib/hubsignin.mjs), and writes each session
// as a Playwright storage state, 0600. qa-run runs it and deletes both after
// the run; the agent's browser loads them.
// Prints one JSON line: { ok, stack, enrolled } or { ok: false, error }. No
// link, code or cookie is ever printed.
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { signIn, signInApp, writeStorageState } from '../lib/hubsignin.mjs';
import { ZONE, NAME } from '../lib/prstacks.mjs';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const arg = (k) => { const i = process.argv.indexOf(`--${k}`); return i > 0 ? process.argv[i + 1] : undefined; };
const stack = arg('stack'), incarnation = arg('incarnation'), port = Number(arg('mailpit-port'));
const adminOut = arg('admin-out'), appOut = arg('app-out');
const runs = path.resolve(arg('runs-dir') ?? process.env.MIU_RUNS_DIR ?? path.join(ROOT, 'runs'));
const say = (o) => { console.log(JSON.stringify(o)); process.exit(o.ok ? 0 : 1); };

if (!stack || !NAME.test(stack) || !/^pr-hub-(\d{1,6}|base)$/.test(stack)) say({ ok: false, error: 'a full PR stack name (pr-hub-<n> or pr-hub-base) is needed' });
if (!incarnation || !Number.isInteger(port) || port < 1024 || port > 65535 || !adminOut || !appOut) say({ ok: false, error: 'usage: --stack --incarnation --mailpit-port --admin-out --app-out' });

try {
  const mailpit = `http://127.0.0.1:${port}/mail`;
  const { cookie, enrolled } = await signIn({
    admin: `https://admin-${stack}.${ZONE}`, mailpit, stack, incarnation,
    totpFile: path.join(runs, '.stacks', `${stack}.totp`),
  });
  writeStorageState(path.resolve(adminOut), cookie);
  const app = await signInApp({ hub: `https://hub-${stack}.${ZONE}`, mailpit });
  writeStorageState(path.resolve(appOut), app.cookie);
  say({ ok: true, stack, enrolled });
} catch (e) {
  say({ ok: false, stack, error: String(e.message).slice(0, 300) });
}
