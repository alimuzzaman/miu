#!/usr/bin/env node
// miu-queue: the dashboard's queue controls from a terminal on Miu's server.
//
//   miu-queue status                       mode, paused, the line, CI
//   miu-queue auto | manual                start tests on their own, or only when asked
//   miu-queue pause | resume               hold the whole queue (tests and CI), or go on
//   miu-queue start owner/repo#12 [...]    test these now, with their CI (--full: every claim)
//   miu-queue hold | release owner/repo#12 set one queued pull request aside, or let it go
//   miu-queue unqueue owner/repo#12        take it out of the line
//   miu-queue ci owner/repo#12 [--again]   run its CI at its head (again)
//   miu-queue stop <run-name>              stop a running test (it is cancelled, not paused)
//
// Run it as Miu's account, from Miu's folder:
//   sudo -u miu /opt/miu/node/bin/node /srv/miu/bin/miu-queue status
// It writes a request into runs/.inbox, which the running dashboard answers
// within seconds; nothing goes over the network. --json prints the answer as is.
import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import { fileURLToPath } from 'node:url';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const argv = process.argv.slice(2);
const flag = (n) => { const i = argv.indexOf(n); if (i > -1) argv.splice(i, 1); return i > -1; };
const opt = (n) => { const i = argv.indexOf(n); if (i < 0) return null; const v = argv[i + 1]; argv.splice(i, 2); return v; };
const asJson = flag('--json');
const full = flag('--full');
const again = flag('--again');
const runs = path.resolve(opt('--runs') ?? path.join(ROOT, 'runs'));
const [action, ...rest] = argv;
const usage = () => { console.error(fs.readFileSync(fileURLToPath(import.meta.url), 'utf8').split('\n').slice(2, 11).map((l) => l.replace(/^\/\/ ?/, '')).join('\n')); process.exit(2); };

const one = ['hold', 'release', 'unqueue', 'ci'];
let req;
if (['status', 'auto', 'manual', 'pause', 'resume'].includes(action) && !rest.length) req = { action };
else if (action === 'start' && rest.length) req = { action, prs: rest, full };
else if (one.includes(action) && rest.length === 1) req = { action, pr: rest[0], again };
else if (action === 'stop' && rest.length === 1) req = { action, run: rest[0] };
else usage();
req.by = process.env.SUDO_USER || process.env.USER || 'someone';

const inbox = path.join(runs, '.inbox');
if (!fs.existsSync(inbox)) { console.error(`No ${inbox}: is the dashboard running, and is this Miu's account?`); process.exit(1); }
const id = crypto.randomBytes(12).toString('hex');
const tmp = path.join(inbox, `.${id}.tmp`);
fs.writeFileSync(tmp, JSON.stringify(req), { mode: 0o600 });
fs.renameSync(tmp, path.join(inbox, `${id}.json`));

const replyFile = path.join(inbox, `${id}.reply`);
// Switching to auto reads every open pull request's head first, which can take a while.
const until = Date.now() + 90000;
while (!fs.existsSync(replyFile)) {
  if (Date.now() > until) { fs.rmSync(path.join(inbox, `${id}.json`), { force: true }); console.error('The dashboard did not answer in 90 seconds. Is miu.service running? (If it took the request late, it may still have acted: check with miu-queue status.)'); process.exit(1); }
  await new Promise((r) => setTimeout(r, 250));
}
const reply = JSON.parse(fs.readFileSync(replyFile, 'utf8'));
fs.rmSync(replyFile, { force: true });
if (asJson) { console.log(JSON.stringify(reply, null, 2)); process.exit(reply.ok ? 0 : 1); }
if (!reply.ok) { console.error(reply.error); process.exit(1); }

const r = reply.result;
const WAITS = { paused: 'paused', held: 'held', manual: 'waits for a person (manual mode)' };
if (r && r.mode) {
  console.log(`Mode: ${r.mode}${r.paused ? `, PAUSED${r.pausedBy ? ` by ${r.pausedBy}` : ''}${r.pausedAt ? ` at ${r.pausedAt}` : ''}` : ''}`);
  console.log(`Running: ${r.live ?? 'nothing'}`);
  if (r.held) console.log(`On hold: ${r.held}`);
  console.log(`Queue: ${r.queue.length ? '' : 'empty'}`);
  r.queue.forEach((q, i) => console.log(`  ${i + 1}. ${q.key}  ${q.waits ? WAITS[q.waits] : 'next to start'}  (${q.by}: ${q.why ?? ''})`));
  console.log(`CI: ${r.ci.running} running, ${r.ci.queued} queued, up to ${r.ci.parallel} at once`);
  if (r.started) console.log(`Started: ${r.started.join(', ')}${r.paused ? ' (the queue is paused: they start when it resumes)' : ''}`);
} else if (r && r.jobs) {
  console.log(`CI for ${r.repo}#${r.pr} at ${r.sha.slice(0, 7)}: ${r.state}${r.reason ? `, ${r.reason}` : ''}`);
  for (const j of r.jobs) console.log(`  ${j.status.padEnd(8)} ${j.label}${j.reason ? `: ${j.reason}` : ''}`);
} else console.log(JSON.stringify(r));
