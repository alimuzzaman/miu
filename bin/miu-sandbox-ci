#!/usr/bin/env bash
# Run one GitHub Actions workflow with the Sandbox CLI on this server.
#
# Installed as /usr/local/lib/miu/sandbox-ci. It runs as the account that owns
# Sandbox, through the one sudo rule install.sh --sandbox-user adds, because
# Miu's own account has no Docker access. The pull request's files arrive as a
# tar on stdin, so that account never reads Miu's folders.
#
#   sandbox-ci <workflow> <event> <timeout-seconds> <job> [matrix-key=value...]
#
# Before the tar, stdin carries a header: a line `miu-ci-secrets <n>`, then n
# lines NAME=value. They are this run's secrets (a GitHub token Miu minted for
# the repositories the workflow checks out), handed to Sandbox on a pipe; they
# are never in an argument, the environment, or a file this script keeps.
# The first line may go on with ` repo=owner/name`: the pull request's
# repository, which picks its line in /etc/miu/ci-secret-names (below).
# Then ` mirrors=owner/name,...`: repositories this
# server reads with a deploy key (/etc/miu/ci-mirrors), whose copies Miu put in
# the tar under .miu-ci/mirrors. Git in the job reads each copy for the
# repository's GitHub URLs. This account never holds a deploy key.
# Then ` allow=NAME,...`: the server's CI secrets (Sandbox's ci_secrets) the
# workflow may name besides the NAME=value lines, which are the ones the base
# branch's same job names. The pull request wrote the workflow; any other name
# it holds refuses the run.
#
# Miu's account sends that header, and it also runs pull request code in fast
# checks, so repo= and allow= are only what Miu asks for. The server's CI
# secrets a run may name are those allow= names that root's own list,
# /etc/miu/ci-secret-names, gives the repo= repository: lines of
# `owner/name NAME,NAME`, # for comments. No such file, or one that is not
# root's or that group or others can write, gives none. Nothing here proves
# which repository the tar came from (Miu's account could name another), so
# every name on that list is one a pull request on this server could reach.
#
# Prints the JSON report of `sb ci run` on stdout. Nothing on stdin or in the
# tar is trusted: that account can reach Docker, and Miu's account cannot.
set -euo pipefail
# This script and Sandbox read the workflow as UTF-8 whatever locale sudo keeps,
# so both see the same lines.
export LC_ALL=C.UTF-8 PYTHONUTF8=1

die() { echo "$*" >&2; exit 2; }
[ $# -ge 4 ] || die "usage: sandbox-ci <workflow> <event> <timeout-seconds> <job> [matrix-key=value...]"
workflow=$1 event=$2 seconds=$3 job=$4
shift 4

[[ $workflow =~ ^\.github/workflows/[A-Za-z0-9_.-]+\.ya?ml$ ]] || die "not a workflow path: $workflow"
[[ $event =~ ^[a-z_]{1,64}$ ]] || die "not an event name: $event"
# Events a release, a deploy or automation runs on: never played here.
case $event in release|deployment|deployment_status|registry_package|pull_request_target|workflow_run|issues|issue_comment) die "refused: Miu never plays the $event event, which a release, a deploy or automation runs on" ;; esac
[[ $seconds =~ ^[0-9]{1,5}$ ]] || die "not a timeout: $seconds"
[[ $job =~ ^[A-Za-z0-9_][A-Za-z0-9_-]*$ ]] || die "not a job id: $job"
matrix_args=()
for pair in "$@"; do
  [[ $pair =~ ^[A-Za-z0-9_][A-Za-z0-9_-]*=[A-Za-z0-9_.-]+$ ]] || die "not a matrix value: $pair"
  matrix_args+=(--matrix-filter "$pair")
done

# Read before anything else touches stdin. The values stay in this shell.
IFS= read -r header || die "not run: no secrets header from Miu"
[[ $header =~ ^miu-ci-secrets\ ([0-9])(\ repo=([A-Za-z0-9-]+/[A-Za-z0-9_.-]+))?(\ mirrors=([A-Za-z0-9_.,/-]{1,512}))?(\ allow=([A-Za-z0-9_,]{1,2048}))?$ ]] || die "not run: no secrets header from Miu; update Miu and this worker together"
secret_count=${BASH_REMATCH[1]}
run_repo=${BASH_REMATCH[3]}
mirror_list=${BASH_REMATCH[5]}
allow_list=${BASH_REMATCH[7]}
secret_lines=()
for ((i = 0; i < secret_count; i++)); do
  IFS= read -r line || die "not run: the secrets header is cut short"
  # Never echo the line: it holds a secret.
  [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]{0,63}=[A-Za-z0-9_.-]{1,4096}$ ]] || die "not run: a secret from Miu is not a plain NAME=value"
  secret_lines+=("$line")
done
unset header line

# The token ends with this run, revoked here as well as by Miu, so it ends
# also when Miu restarted or stopped waiting. curl reads its header from
# stdin (-K -), so the token is in no process's arguments.
revoke_token() {
  local l
  for l in ${secret_lines[@]+"${secret_lines[@]}"}; do
    # Only an installation token (ghs_), never anything else in that line.
    [[ $l == GITHUB_TOKEN=ghs_* ]] || continue
    printf 'header = "Authorization: token %s"\n' "${l#GITHUB_TOKEN=}" \
      | timeout -k 5 30 curl -sS --fail --retry 2 -o /dev/null -X DELETE -H 'Accept: application/vnd.github+json' -H 'User-Agent: miu' -K - https://api.github.com/installation/token >/dev/null 2>&1 \
      || echo "sandbox-ci: could not revoke the run's GitHub token; Miu tries too, and it expires within the hour" >&2
  done
}
trap revoke_token EXIT

sb="$HOME/sandbox/sb-src/sb"
[ -x "$sb" ] || die "no Sandbox CLI at $sb"

# Inside this script, because Miu's account cannot signal this one to stop it.
bounded() { timeout -k 10 "$1" "${@:2}"; }

# Jobs run as runner, uid 1001 (sb ci run --as-runner), in a workspace this
# account owns, so another uid here fails every job the way a broken pull
# request would. sudo resets the environment, so only a test sets the uid.
[ "$(id -u)" = "${MIU_CI_RUNNER_UID:-1001}" ] || die "not run: the Sandbox account $(id -un) is uid $(id -u), and CI jobs run as runner, uid 1001, which cannot write to its workspace"

# This server is shared: never start while Sandbox is applying a hosting change.
# These are the locks a host apply holds (Sandbox's sandbox/resources/host_guard.py),
# probed shared and non-blocking the same way. sudo resets the environment, so
# only a test can point these elsewhere.
apply_locks=${MIU_CI_APPLY_LOCKS:-/run/lock/sandbox-hosting-caddy.lock /run/lock/sandbox-edge-nginx.lock /run/lock/sandbox-docker-pool.lock}
# shellcheck disable=SC2086
python3 -I -c '
import errno, fcntl, os, sys
for path in sys.argv[1:]:
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        continue
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except OSError as e:
        if e.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
            sys.exit(3)
    finally:
        os.close(fd)
' $apply_locks || die "not run: a Sandbox host apply is in progress on this server; try again later"
# How many runs at once depends on what this server has free. Each run's job
# container gets a fixed share (run_mem_gb, run_cpus). miu-ci.slice caps them all
# together (pool_*; install.sh makes it) at a low CPU weight, so a busy server
# runs CI slower instead of refusing it: only memory decides. A run starts if the
# server still keeps reserve_mem_gb free once its container is going. A run holds
# one slot: an flock on fd 9, which this script keeps open until it exits.
# sudo resets the environment, so only a test can change these numbers.
run_mem_gb=${MIU_CI_RUN_MEM_GB:-2} run_cpus=${MIU_CI_RUN_CPUS:-2}
pool_mem_gb=${MIU_CI_POOL_MEM_GB:-4} pool_cpus=${MIU_CI_POOL_CPUS:-4}
reserve_mem_gb=${MIU_CI_RESERVE_MEM_GB:-2}
# In this account's own home, so Miu's account cannot make the folder first and hold every slot.
slots=${MIU_CI_SLOTS_DIR:-$HOME/.cache/miu-sandbox-ci-slots}
mkdir -p -m 0700 "$slots"
slot=$(python3 -I - "$slots" "$run_mem_gb" "$run_cpus" "$pool_mem_gb" "$pool_cpus" "$reserve_mem_gb" <<'SLOTS'
import fcntl, os, sys
folder = sys.argv[1]
run_mem, run_cpus, pool_mem, pool_cpus, reserve_mem = map(float, sys.argv[2:7])
most = int(min(pool_mem // run_mem, pool_cpus // run_cpus))

def free_now():
    # Tests set this; on the server it comes from the kernel.
    mem = os.environ.get("MIU_CI_FREE_MEM_GB")
    if mem is None:
        try:
            with open("/proc/meminfo") as f:
                info = dict(line.split(":", 1) for line in f)
            mem = int(info["MemAvailable"].split()[0]) / 1048576
        except (OSError, KeyError, ValueError):
            mem = float("inf")
    return float(mem)

def busy(index):
    fd = os.open(os.path.join(folder, f"{index}.lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return True
    else:
        fcntl.flock(fd, fcntl.LOCK_UN)
        return False
    finally:
        os.close(fd)

if most < 1:
    sys.exit("not run: Sandbox CI has no room configured on this server")
mem = free_now()
# No CPU check: the load on a server full of stacks keeps idle cores near 0 all
# day, and miu-ci.slice (CPUWeight=20, CPUQuota) already yields to them.
if mem - run_mem < reserve_mem:
    sys.exit(f"not run: this server is busy ({mem:.1f} GB memory free; a job needs {run_mem + reserve_mem:.0f} GB); try again later")
for index in range(most):
    if not busy(index):
        print(index)
        sys.exit(0)
sys.exit(f"not run: all {most} Sandbox CI slots on this server are in use; try again later")
SLOTS
) || exit 2
[[ $slot =~ ^[0-9]+$ ]] || die "not run: could not take a Sandbox CI slot"
exec 9>>"$slots/$slot.lock"
python3 -I -c '
import fcntl, sys
try:
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(3)
' || die "not run: all Sandbox CI slots on this server are in use; try again later"

root=$(mktemp -d "${TMPDIR:-/tmp}/miu-ci.XXXXXX")
config=$(mktemp -d "${TMPDIR:-/tmp}/miu-ci-config.XXXXXX")
cleanup() {
  revoke_token
  bounded 60 docker rm -f "miu-probe-${root##*/}" >/dev/null 2>&1 || true
  # A job stopped at its time limit leaves its containers behind.
  for id in $(bounded 30 docker ps -aq --filter name=act- 2>/dev/null || true); do
    if bounded 30 docker inspect -f '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' "$id" 2>/dev/null | grep -qF "${root##*/}"; then
      bounded 30 docker rm -f "$id" >/dev/null 2>&1 || true
    fi
  done
  # Jobs run as runner (uid 1001), but a container: job or a service keeps its
  # image's user, often root, so what they wrote needs root to remove. act-22.04
  # is there on a server whose install.sh has not pulled runner-22.04 yet.
  for image in catthehacker/ubuntu:runner-22.04 catthehacker/ubuntu:act-22.04; do
    bounded 120 docker run --rm --pull=never --user 0 -v "$root:/work" --entrypoint find "$image" /work -mindepth 1 -delete >/dev/null 2>&1 && break
  done
  bounded 120 rm -rf "$root" "$config" 2>/dev/null || true
}
trap cleanup EXIT

bounded 300 tar -x -C "$root"
[ -f "$root/$workflow" ] || die "the pull request has no $workflow"
# Miu reads the workflow too, and stops at less than this.
[ "$(wc -c < "$root/$workflow")" -le 524288 ] || die "refused: $workflow is over 512 KB"
# The names Miu gives, and those the base branch's same job uses that root's
# list gives this repository: nothing else. sudo resets the environment, so
# only a test points these elsewhere.
names_file=${MIU_CI_SECRET_NAMES:-/etc/miu/ci-secret-names}
names_owner=${MIU_CI_SECRET_NAMES_OWNER:-0:0}
declare -A listed=()
if [ -L "$names_file" ] || [ ! -f "$names_file" ]; then
  unlisted_why="the base branch's job names, but $names_file is missing or a link, so this server gives none"
elif ! meta=$(stat -c '%u:%g %a' "$names_file") || [[ ${meta% *} != "$names_owner" ]] || (( 8#${meta#* } & 8#022 )); then
  unlisted_why="the base branch's job names, but $names_file is not root's own file that only root can write, so this server gives none"
else
  unlisted_why="the base branch's job names, but $names_file does not list for ${run_repo:-this repository (Miu named none)}"
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    IFS=$' \t,' read -r -a words <<<"$line"
    [ ${#words[@]} -gt 1 ] && [ -n "$run_repo" ] && [[ ${words[0],,} == "${run_repo,,}" ]] || continue
    for n in "${words[@]:1}"; do
      [[ $n =~ ^[A-Za-z_][A-Za-z0-9_]{0,63}$ ]] && listed[$n]=1
    done
  done < "$names_file"
fi
allowed= unlisted=
IFS=, read -r -a asked <<<"$allow_list"
for n in ${asked[@]+"${asked[@]}"}; do
  [ -n "$n" ] || continue
  if [ -n "${listed[$n]+x}" ]; then allowed+=",$n"; else unlisted+=",$n"; fi
done
# Names Miu sends a value for need no list: Sandbox gives --secrets-stdin values
# precedence over ci_secrets, and a value is never empty (above), so a forged
# NAME=x line reaches only its own x, never the server's secret of that name.
for l in ${secret_lines[@]+"${secret_lines[@]}"}; do allowed+=",${l%%=*}"; done

# Miu's account runs pull request code in its fast checks, so it can call this
# script with any tar. Before act sees the workflow, check what it asks of Docker.
links=$(find "$root/.github" -type l -print -quit) || die "refused: .github has a folder this account cannot read"
[ -z "$links" ] || die "refused: a symbolic link under .github"
bounded 60 python3 -I - "$root/$workflow" "$job" "$allowed" "$unlisted" "$unlisted_why" <<'POLICY'
import json, os, re, resource, shlex, sys
import yaml
# The pull request wrote this YAML: aliases that expand without end stop here.
resource.setrlimit(resource.RLIMIT_AS, (1 << 30, 1 << 30))

path = sys.argv[1]

def refuse(why):
    sys.exit(f"refused: {os.path.basename(path)}: {why}")

def check(what, c):
    if not isinstance(c, dict):
        refuse(f"{what} must be a mapping")
    extra = set(map(str, c)) - {"image", "env", "ports", "credentials", "options"}
    if extra:
        refuse(f"{what} sets {', '.join(sorted(extra))}")
    options = c.get("options")
    if options is None:
        return
    # act splits these with a different parser, which joins escaped lines.
    if not isinstance(options, str) or "${{" in options or "\\" in options or any(ord(ch) < 32 and ch not in "\t\n" for ch in options):
        refuse(f"{what} has options that are not plain text")
    for word in shlex.split(options):
        if word.startswith("-") and not word.startswith("--health-"):
            refuse(f"{what} has the option {word}")

try:
    with open(path, encoding="utf-8") as f:
        doc = yaml.safe_load(f)
except (yaml.YAMLError, UnicodeDecodeError, RecursionError, MemoryError):
    refuse("not readable as YAML")
jobs = doc.get("jobs") if isinstance(doc, dict) else None
if not isinstance(jobs, dict):
    refuse("no jobs mapping")
# Never a deploy, a release or a notice, whatever Miu's account asks for (the
# owner's list, the same as lib/ci.mjs NEVER_RUN): by the file's name, the
# workflow's name, and below each job's id and name.
# The words anywhere in a name (deployment, prerelease, autodeploy), camelCase
# split first (DeployToProd); tag only as a word of its own.
NEVER_WORDS = re.compile(r"deploy|release|publish|website[- _]?sync|announce|slack|close[- _]?issues|(^|[^a-z0-9])tags?([^a-z0-9]|$)", re.I)
class _Never:
    @staticmethod
    def search(name):
        return NEVER_WORDS.search(re.sub(r"([a-z0-9])([A-Z])", r"\1-\2", name))
NEVER = _Never
if NEVER.search(re.sub(r"\.ya?ml$", "", os.path.basename(path), flags=re.I)) or (isinstance(doc.get("name"), str) and NEVER.search(doc["name"])):
    refuse("it is a deploy, release or notification workflow, which Miu never runs")
# Sandbox fills each secrets.X inside ${{ }} of a step from the server's
# ci_secrets (sandbox/commands/ci.py _secret_refs, over json.dumps of the parsed
# step). The same patterns, over each step and over the whole file as parsed
# here, from the bytes act reads: more names than Sandbox fills, never fewer.
EXPR = re.compile(r"\$\{\{(.*?)\}\}", re.DOTALL)
REF = re.compile(r"\bsecrets\s*(?:\.\s*([A-Za-z_][A-Za-z0-9_]*)|\[\s*['\"]([A-Za-z_][A-Za-z0-9_]*)['\"]\s*\])")
# A step whose condition is exactly !env.ACT is one act leaves out, and Sandbox
# fills none of its names (_runtime_secrets_needed, the same pattern).
ACT_SKIP = re.compile(r"\s*(?:\$\{\{\s*)?!\s*env\.ACT\s*(?:\}\})?\s*")
def named(value):
    return {a or b for block in EXPR.findall(json.dumps(value, default=str)) for a, b in REF.findall(block)}
def kept(job):
    if not isinstance(job, dict) or not isinstance(job.get("steps"), list):
        return job
    return {**job, "steps": [s for s in job["steps"] if not (isinstance(s, dict) and isinstance(s.get("if"), str) and ACT_SKIP.fullmatch(s["if"]))]}
# Sandbox fills only the --job's own steps, one by one; the jobs it needs get
# the same file, so they reach no other name. Deploy-class steps count here
# too, which only refuses more.
names = set()
try:
    job = kept(jobs.get(sys.argv[2]))
    for step in (job.get("steps") if isinstance(job, dict) and isinstance(job.get("steps"), list) else []):
        names |= named(step)
except (TypeError, ValueError, RecursionError, MemoryError):
    refuse("cannot read it as data")
extra = sorted(names - set(filter(None, sys.argv[3].split(","))))
# Names allow= asks for that root's list does not give this repository.
held = [n for n in extra if n in set(sys.argv[4].split(","))]
if held:
    refuse(f"it names CI secrets {sys.argv[5]}: {', '.join(held[:5])}")
if extra:
    refuse(f"it names CI secrets its base branch's job does not: {', '.join(extra[:5])}")
for job_id, job in jobs.items():
    if not isinstance(job, dict):
        refuse(f"job {job_id} must be a mapping")
    # act opens a called workflow when it reaches it, after earlier jobs could
    # have rewritten it in the shared workspace.
    if job.get("uses") is not None:
        refuse(f"job {job_id} calls another workflow")
    # act reads a local action from the workspace on this server when the step
    # comes, after earlier steps could rewrite it, and builds Docker ones here.
    for step in (job.get("steps") if isinstance(job.get("steps"), list) else []):
        uses = step.get("uses") if isinstance(step, dict) else None
        if isinstance(uses, str) and (uses.startswith(".") or uses.startswith("/") or uses.lower().startswith("docker://")):
            refuse(f"job {job_id} uses {uses[:60]}: a local or Docker action")
    # A key that is not a string reads differently in the plan and in the run,
    # so the count of runs below would not hold.
    strategy = job.get("strategy")
    matrix = strategy.get("matrix") if isinstance(strategy, dict) else None
    if isinstance(matrix, dict):
        rows = [matrix] + [r for k in ("include", "exclude") if isinstance(matrix.get(k), list) for r in matrix[k]]
        if any(not isinstance(k, str) for r in rows if isinstance(r, dict) for k in r):
            refuse(f"job {job_id} has a matrix name that is not text")
    container = job.get("container")
    if container is not None and not isinstance(container, str):
        check(f"job {job_id} container", container)
    services = job.get("services")
    if services is not None:
        if not isinstance(services, dict):
            refuse(f"job {job_id} services must be a mapping")
        for service_id, service in services.items():
            check(f"service {service_id}", service)

# act skips a job on a label with no runner and exits 0, and quotes the label in
# its log. The job that runs, and what it needs, must be on a label Sandbox maps.
seen, todo = set(), [sys.argv[2]]
while todo:
    job_id = todo.pop()
    if job_id in seen or job_id not in jobs:
        continue
    seen.add(job_id)
    if jobs[job_id].get("runs-on") not in ("ubuntu-latest", "ubuntu-22.04"):
        refuse(f"job {job_id} must run on ubuntu-latest or ubuntu-22.04")
    needs = jobs[job_id].get("needs") or []
    todo += [needs] if isinstance(needs, str) else [n for n in needs if isinstance(n, str)]
# The job and every job it needs: never one named for a deploy, a release or a
# notice, and never one that deploys to an environment.
for job_id in sorted(seen):
    title = jobs[job_id].get("name")
    if NEVER.search(job_id) or (isinstance(title, str) and NEVER.search(title)):
        refuse(f"job {job_id} is named for a deploy, release or notification, which Miu never runs")
    if jobs[job_id].get("environment") is not None:
        refuse(f"job {job_id} deploys to an environment, which Miu never runs")
# A job skipped by its condition leaves the success of the job it needs as the
# only result in the log, and that would read as its own.
if len(seen) > 1 and any("if" in jobs[j] for j in seen):
    refuse("a job with needs cannot have a condition")
POLICY

# act runs on this server and reads these from the folder it runs in. .actrc is
# options for act. The others are values for the job, and a link there would
# hand a job a file from this server. A plain file holds nothing new.
bounded 60 rm -rf "$root/.actrc"
for f in .env .vars .input .secrets; do
  if [ -L "$root/$f" ]; then rm -f "$root/$f"; fi
done
# A FIFO would block a write, a folder fail it.
if [ -e "$root/.env" ] && [ ! -f "$root/.env" ]; then die "refused: .env is not a plain file"; fi
# Deploy-key copies come in the tar under .miu-ci, as plain folders (checked below).
if [ -L "$root/.miu-ci" ]; then rm -f "$root/.miu-ci"; fi
# act's own settings keep the Docker socket out of jobs: with the socket a job
# could start a container that owns this server.
mkdir "$config/act"
echo '--container-daemon-socket=-' > "$config/act/actrc"
# Without the socket, act (0.2.9x) also restricts a workflow's container
# options and host-path volumes, and so refuses the caps and the node this
# worker gives a container: job (below). The workflow policy above already
# lets a pull request set only --health-* options and no volumes, so what
# this permits is what this worker adds. An act without the option has no
# such restriction.
# Read whole first: grep -q under pipefail would end act early and read as "no such option".
act_help=$(bounded 30 act --help 2>/dev/null || true)
if [[ $act_help == *--container-options-policy* ]]; then
  echo '--container-options-policy=allow' >> "$config/act/actrc"
fi
unset act_help
export XDG_CONFIG_HOME="$config"
# Sandbox writes act's secret file to TMPDIR; here it is gone with the folder
# even if Sandbox is stopped before it can delete it.
export TMPDIR="$config"

# Workflows expect a git checkout, and an archive has none. Any .git that came
# in the tar is not ours, and its hooks would run here.
bounded 120 rm -rf "$root/.git"
quiet_git() { bounded 120 git -C "$root" -c core.hooksPath=/dev/null -c user.name=miu -c user.email=miu@localhost "$@"; }
quiet_git init -q

# Repositories this server reads with a deploy key (/etc/miu/ci-mirrors). Miu
# gets each one from bin/miu-ci-mirror, which runs as its own account and
# alone holds the keys, and puts a bare copy of it in the tar at
# .miu-ci/mirrors/<owner>/<name>.git. This script runs no git in those copies
# and reads no key: it checks that they are plain files and folders, and gives
# the job git config, through its .env, that reads each copy for the
# repository's GitHub URLs. act gives the job the variables in .env (the pull
# request's own; it reaches only its own job). Config through the
# environment adds to the job's own instead of replacing it.
if [ -n "$mirror_list" ]; then
  # Not part of the pull request: never committed, out of git status in the job.
  echo /.miu-ci/ >> "$root/.git/info/exclude"
  IFS=, read -r -a mirror_repos <<<"$mirror_list"
  [ ${#mirror_repos[@]} -le 4 ] || die "not run: more than 4 deploy-key repositories"
  [ -d "$root/.miu-ci" ] || die "not run: Miu sent no deploy-key copies"
  # find must read every folder: one it cannot list would hide what is in it,
  # and keep the cleanup from removing it. chmod changes a folder before it
  # reads it, and follows no link.
  bounded 60 chmod -R u+rwX "$root/.miu-ci" 2>/dev/null || true
  odd=$(find "$root/.miu-ci" \( -type l -o ! -type f ! -type d \) -print -quit) || die "refused: .miu-ci has a folder this account cannot read"
  [ -z "$odd" ] || die "refused: a link or special file under .miu-ci"
  mirror_config=()
  for repo in "${mirror_repos[@]}"; do
    [[ $repo =~ ^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$ && $repo != */. && $repo != */.. ]] || die "not run: not a repository name: $repo"
    copy=$root/.miu-ci/mirrors/${repo,,}.git
    [ -d "$copy/objects" ] && [ -f "$copy/HEAD" ] || die "not run: Miu sent no copy of $repo"
    # A container: job may run as another uid than this account, which owns the copy, hence safe.directory.
    for u in "git@github.com:$repo.git" "ssh://git@github.com/$repo.git" "https://github.com/$repo.git"; do
      mirror_config+=("url.$copy.insteadOf" "$u")
    done
    mirror_config+=(safe.directory "$copy")
  done
  if [ -e "$root/.env" ] && [ ! -r "$root/.env" ]; then die "refused: .env is not readable"; fi
  if [ -f "$root/.env" ] && grep -qE '^[[:space:]]*(export[[:space:]]+)?GIT_CONFIG_(COUNT|KEY_|VALUE_|PARAMETERS)' "$root/.env"; then
    die "refused: the pull request's .env sets GIT_CONFIG_COUNT, _KEY_ or _VALUE_ variables, which Miu needs for a deploy-key repository"
  fi
  # First in .env: act reads a quoted value across lines, and an open quote
  # can only take in what comes after it.
  {
    echo "GIT_CONFIG_COUNT=$(( ${#mirror_config[@]} / 2 ))"
    for ((i = 0; i < ${#mirror_config[@]}; i += 2)); do
      echo "GIT_CONFIG_KEY_$((i / 2))=${mirror_config[i]}"
      echo "GIT_CONFIG_VALUE_$((i / 2))=${mirror_config[i + 1]}"
    done
    if [ -f "$root/.env" ]; then cat "$root/.env"; fi
  } > "$root/.env.miu-ci"
  mv -f "$root/.env.miu-ci" "$root/.env"
else
  bounded 60 rm -rf "$root/.miu-ci"
fi

# Where the job's own test reports are copied to (below): never the pull request's.
bounded 60 rm -rf "$root/.miu-ci-reports"
echo /.miu-ci-reports/ >> "$root/.git/info/exclude"
quiet_git add -A
# Never in the pull request's commit, whatever its .gitignore says.
quiet_git rm -r -q --cached --ignore-unmatch -- .miu-ci
quiet_git commit -q --no-verify --no-gpg-sign --allow-empty -m "pull request"

# One job and one matrix combination, so one act process. A job can write to the
# workspace, and a second process would read an .actrc the first one left there.
# Sandbox starts one act per combination; each of those is its own fast check.
plan=$(bounded 60 "$sb" ci plan "$root/$workflow" --json)
bounded 30 python3 -I -c '
import json, sys
job, pairs = sys.argv[1], [a.split("=", 1) for a in sys.argv[2:]]
plan = json.loads([l for l in sys.stdin if l.startswith("{")][-1])
cells = [c for j in plan["jobs"] if j["id"] == job for c in j["cells"] if all(str(c["matrix"].get(k)) == v for k, v in pairs)]
if len(cells) != 1:
    sys.exit(f"refused: {len(cells)} matching runs of job {job}; a check runs exactly one, so name the matrix values")
' "$job" "$@" <<<"$plan"

# What this worker adds to the workflow, after the policy above has passed it
# and after the commit, so the job's own commit stays the pull request's:
# - A container: job runs in the image the workflow names, with options that
#   are only --health-* (above), and act gives it none of Sandbox's
#   --container-options: it gets the same caps here. act runs a JavaScript
#   action (actions/checkout, actions/cache) with the node of that image, where
#   GitHub mounts its own; an image with no node (php:8.3-cli) gets this
#   server's node, read only, at /usr/local/bin/node. An image that has node
#   keeps its own.
# - The job's last step copies its own test reports (the paths its steps give
#   to --outputFile, --log-junit or --junitxml) into the workspace, so the
#   failing tests are known after the run: Sandbox keeps only the tail of a
#   job's output.
# Sandbox reads and writes the file with PyYAML the same way before act sees it.
# sudo resets the environment, so only a test points these elsewhere.
node_bin=${MIU_CI_NODE_BIN:-/opt/miu/node/bin/node}
bounded 1200 python3 -I - "$root/$workflow" "$job" "$node_bin" "$run_mem_gb" "$run_cpus" "$@" <<'PREPARE'
import os, re, subprocess, sys
import yaml
# No memory cap here, unlike the policy: docker is started from here. The
# policy read this same file under one, so its aliases are bounded.
path, job_id, node_bin, mem, cpus = sys.argv[1:6]
pairs = dict(a.split("=", 1) for a in sys.argv[6:])
with open(path, encoding="utf-8") as f:
    doc = yaml.safe_load(f)
if True in doc and "on" not in doc:
    doc["on"] = doc.pop(True)
jobs = doc["jobs"]
seen, todo = [], [job_id]
while todo:
    j = todo.pop()
    if j in seen or not isinstance(jobs.get(j), dict):
        continue
    seen.append(j)
    needs = jobs[j].get("needs") or []
    todo += [needs] if isinstance(needs, str) else [n for n in needs if isinstance(n, str)]
IMAGE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._/:@-]{0,254}")
MATRIX = re.compile(r"\$\{\{\s*matrix\.([A-Za-z_][A-Za-z0-9_-]*)\s*\}\}")
PROBE = "miu-probe-" + os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(path))))
def has_node(image):
    # The image act will run anyway, with no network, nothing mounted, small
    # caps, and a name of this run's, so that it is removed whatever happens
    # (here, and in the worker's cleanup).
    try:
        r = subprocess.run(["docker", "run", "--rm", "--name", PROBE, "--pull=missing", "--network=none", "--memory=256m", "--cpus=0.5", "--pids-limit=64", "--cgroup-parent=miu-ci.slice",
                            "--entrypoint", "sh", image, "-c", "command -v node >/dev/null 2>&1 && exit 0; exit 3"],
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=600)
    except (OSError, subprocess.SubprocessError):
        return None
    finally:
        subprocess.run(["docker", "rm", "-f", PROBE], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60, check=False)
    # 3 is the image saying it has no node; anything else (no sh, no image) is not known.
    return {0: True, 3: False}.get(r.returncode)
notes, changed = [], False
caps = f"--memory={mem}g --memory-swap={mem}g --cpus={cpus} --cgroup-parent=miu-ci.slice"
for j in seen:
    c = jobs[j].get("container")
    if c is None:
        continue
    c = {"image": c} if isinstance(c, str) else c
    image = c.get("image")
    # The matrix values of this run, for the job it runs; a needed job's own matrix is not known here.
    image = MATRIX.sub(lambda m: pairs.get(m.group(1), m.group(0)), image) if isinstance(image, str) and j == job_id else image
    add = [caps]
    if isinstance(image, str) and IMAGE.fullmatch(image) and os.path.isfile(node_bin) and has_node(image) is False:
        add.append(f"--volume={node_bin}:/usr/local/bin/node:ro")
        notes.append(f"{image} has no node, so Miu gave job {j} this server's node for its JavaScript actions (GitHub mounts its own)")
    # Miu's options first: a dangling --health-cmd at the end of the workflow's cannot take one as its value.
    c["options"] = " ".join(add + [c["options"]]) if isinstance(c.get("options"), str) and c["options"].strip() else " ".join(add)
    jobs[j]["container"] = c
    changed = True
# The paths the job's run steps write test reports to.
REPORT = re.compile(r"(?:--outputFile|--log-junit|--junitxml|--junit-xml)(?:=|[ \t]+)(['\"]?)([A-Za-z0-9_./-]{1,200})\1")
job = jobs[job_id]
def wd(*where):
    for w in where:
        w = ((w or {}).get("run") or {}).get("working-directory") if isinstance(w, dict) else None
        if isinstance(w, str):
            return w
    return ""
reports = []
for st in job.get("steps") if isinstance(job.get("steps"), list) else []:
    if not isinstance(st, dict) or not isinstance(st.get("run"), str):
        continue
    here = st.get("working-directory") if isinstance(st.get("working-directory"), str) else wd(job.get("defaults"), doc.get("defaults"))
    for m in REPORT.finditer(st["run"]):
        p = m.group(2)
        if ".." in p.split("/"):
            continue
        if p.startswith("/"):
            reports.append(p)
        elif re.fullmatch(r"[A-Za-z0-9_./-]*", here):
            reports.append("$GITHUB_WORKSPACE/" + "/".join(x for x in (here.strip("/"), p) if x and x != "."))
if reports and isinstance(job.get("steps"), list):
    lines = ['d="$GITHUB_WORKSPACE/.miu-ci-reports"', 'mkdir -p "$d" || exit 0']
    for k, src in enumerate(dict.fromkeys(reports).keys()):
        if k > 7:
            break
        lines.append(f'if [ -f "{src}" ]; then cp "{src}" "$d/{k}{".xml" if src.endswith(".xml") else ".json"}" || true; fi')
    job["steps"].append({"name": "Miu: keep the test reports", "if": "always()", "shell": "sh", "continue-on-error": True, "run": "\n".join(lines) + "\nexit 0\n"})
    changed = True
if changed:
    with open(path + ".miu", "w", encoding="utf-8") as f:
        yaml.safe_dump(doc, f, sort_keys=False, allow_unicode=True, width=1 << 16)
    os.replace(path + ".miu", path)
for n in notes:
    print(f"miu-ci-note {n}")
PREPARE
# The job's checkout stays clean: git status and git diff in the job do not
# see what this worker changed in the workflow.
quiet_git update-index --skip-worktree -- "$workflow"

# Never --runtime sandbox: that starts what the repository declares, Compose
# files included, with this account's Docker access.
# Every job container is capped and placed in miu-ci.slice (install.sh makes it),
# so CI cannot crowd out what else runs on this server. A Sandbox too old for
# --container-limit refuses the run, so CI never runs uncapped.
# --as-runner runs each job as runner (uid 1001) in Sandbox's runner- image, as
# GitHub does, not as root; a Sandbox without it refuses the run.
# The secrets go to Sandbox on a pipe (printf is a shell builtin, so they are
# in no process's arguments). A Sandbox too old for --secrets-stdin refuses.
# A local run replaces upload-artifact with a no-op and collects nothing, and
# Miu keeps no artifacts, so the differences Sandbox names for artifacts it
# could not collect the way GitHub does are accepted; every other difference
# still refuses the run.
artifact_differences=()
for d in pattern-unsupported runner-temp-unsupported missing-semantics options-unsupported; do
  artifact_differences+=(--accept-difference "sandbox.artifact-$d")
done
run_ci() {
  bounded "$((seconds + 60))" "$sb" ci run "$root/$workflow" --local --project-dir "$root" --json \
    --event "$event" --timeout "$seconds" --runtime none --job "$job" ${matrix_args[@]+"${matrix_args[@]}"} \
    "${artifact_differences[@]}" --as-runner --container-limit "memory=${run_mem_gb}g" --container-limit "cpus=${run_cpus}" --container-limit cgroup-parent=miu-ci.slice "$@"
}
rc=0
if [ ${#secret_lines[@]} -gt 0 ]; then
  printf '%s\n' "${secret_lines[@]}" | run_ci --secrets-stdin || rc=$?
else
  run_ci </dev/null || rc=$?
fi

# The job's own test reports, as one line Miu reads (lib/sandboxci.mjs testsIn):
# test counts and up to 50 failing tests. The job wrote these files, so
# nothing in them is trusted: no link is followed, a file is read only when it
# is a plain one of at most 32 MB, and XML with entities is not read.
bounded 120 python3 -I - "$root" <<'TESTS' || true
import json, os, re, resource, stat, sys
import xml.etree.ElementTree as ET
resource.setrlimit(resource.RLIMIT_AS, (1 << 30, 1 << 30))
root = sys.argv[1]
try:
    dfd = os.open(os.path.join(root, ".miu-ci-reports"), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
except OSError:
    sys.exit(0)
total = passed = failed_count = 0
counted, failed = False, []
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
def text(v, n):
    v = ANSI.sub("", v if isinstance(v, str) else "").strip()
    return (v.splitlines() or [""])[0][:n]
def short(f):
    f = f if isinstance(f, str) else ""
    return f[len(root) + 1:] if f.startswith(root + "/") else f
def add(file, name, message):
    global failed_count
    failed_count += 1
    if len(failed) < 50:
        failed.append({"file": text(short(file), 200) or None, "name": text(name, 300) or "(unnamed test)", "message": text(message, 300) or None})
for name in sorted(os.listdir(dfd)):
    if not re.fullmatch(r"[0-7]\.(json|xml)", name):
        continue
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
    except OSError:
        continue
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            continue
        data = f.read((32 << 20) + 1)
    if len(data) > 32 << 20:
        continue
    try:
        if name.endswith(".json"):
            r = json.loads(data)
            if not isinstance(r, dict) or not isinstance(r.get("testResults"), list):
                continue
            if isinstance(r.get("numTotalTests"), int):
                total += r["numTotalTests"]
                passed += r.get("numPassedTests") if isinstance(r.get("numPassedTests"), int) else 0
                counted = True
            for tr in r["testResults"]:
                if not isinstance(tr, dict):
                    continue
                cases = [a for a in tr.get("assertionResults") or [] if isinstance(a, dict) and a.get("status") == "failed"]
                if not cases and tr.get("status") == "failed":
                    add(tr.get("name"), "(the test file failed to run)", tr.get("message"))
                for a in cases:
                    titles = [t for t in (a.get("ancestorTitles") or []) if isinstance(t, str)] + [a.get("title") if isinstance(a.get("title"), str) else ""]
                    add(tr.get("name"), a.get("fullName") if isinstance(a.get("fullName"), str) else " > ".join(t for t in titles if t), (a.get("failureMessages") or [""])[0])
        else:
            if b"<!ENTITY" in data or b"<!DOCTYPE" in data:
                continue
            parser = ET.XMLParser()
            def no_entities(*_):
                raise ValueError("entities")
            parser.parser.EntityDeclHandler = no_entities
            parser.feed(data)
            for tc in parser.close().iter("testcase"):
                total += 1
                counted = True
                bad = tc.find("failure")
                bad = tc.find("error") if bad is None else bad
                if bad is not None:
                    add(tc.get("file"), "::".join(x for x in (tc.get("classname"), tc.get("name")) if x), bad.get("message") or bad.text)
                elif tc.find("skipped") is None:
                    passed += 1
    except (ValueError, ET.ParseError, RecursionError, MemoryError, TypeError, AttributeError):
        continue
if counted or failed:
    print("miu-ci-tests " + json.dumps({"total": total if counted else None, "passed": passed if counted else None, "failedCount": failed_count, "failed": failed}))
TESTS
exit "$rc"
